# ===============================================================
# Configurações do Torneio Robocode / Chaveamento
# ===============================================================
# Copie este arquivo para 'torneio.properties' para personalizar suas configurações locais.
# Altere estas propriedades quando o projeto for para produção
# (API hospedada em nuvem, credenciais de produção, etc.)
# Você também pode sobrescrever qualquer valor via linha de comando ou variáveis de ambiente.

# URL da API do backend (ex: http://localhost:8080 ou https://api.seudominio.com)
api.url=http://localhost:8080

# Credenciais de autenticação na API
auth.email=admin@admin.com
auth.senha=admin123
# Se preferir usar um token JWT direto em vez de email/senha:
auth.token=

# Regras das partidas
partida.rounds=3
partida.vitorias=2
partida.duasSeguidas=true
partida.resetar=false

# Controle de tempo e velocidade
partida.duracaoSegundos=120
partida.tps=30

# Interface gráfica do Robocode (true = abre a arena, false = headless)
robocode.exibirJanela=true
